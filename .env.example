# ========================================================
# Smalux 环境变量模板示例 (.env.example)
# ========================================================

# 💡 是否启用本地 Mock 仿真数据：true 开启 / false 直连真实后端
VITE_ENABLE_MOCK=true

# 💡 真实后端 REST API 服务基础路径
VITE_API_BASE_URL=/api

# 💡 真实后端 WebSocket 服务路径
VITE_WS_BASE_URL=/ws

# 💡 通信传输模式 (mock | http | ws)
VITE_TRANSPORT=mock
